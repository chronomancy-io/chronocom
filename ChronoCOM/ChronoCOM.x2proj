<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Guid>6b812585-d554-4af7-9ebd-1b3f88ca9e87</Guid>
    <Name>ChronoCOM</Name>
    <Description>AI overhaul for XCOM 2: War of the Chosen. The aliens fight as a hivemind: every pod knows what any alien sees, hears the fight and comes, holds out of sight and goes in together, flanks, flushes cover with grenades and focuses fire on one soldier. Combat values stay vanilla; EMP grenades jam the hive.</Description>
    <Author>the-chronomancer</Author>
    <SteamPublishID>3816506746</SteamPublishID>
    <AssemblyName>ChronoCOM</AssemblyName>
    <RootNamespace>ChronoCOM</RootNamespace>
    <ProjectGuid>{830cc1d7-e2d3-4b9d-88c2-46703ae04aca}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Config\" />
    <Folder Include="Localization\" />
    <Folder Include="Src\" />
    <Folder Include="Src\ChronoCOM\" />
    <Folder Include="Src\ChronoCOM\Classes\" />
  </ItemGroup>
  <ItemGroup>
